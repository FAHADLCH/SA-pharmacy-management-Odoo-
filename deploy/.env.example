# -----------------------------------------------------------------------------
# PharmaCore production environment  (copy to ".env" and edit)
# -----------------------------------------------------------------------------

# --- Odoo series selection ----------------------------------------------------
# Choose ONE matching trio. The module dir / module name must match the series.
#
#   Odoo 18 (recommended):
ODOO_VERSION=18.0
PHARMACY_MODULE=sa_pharmacy_management
PHARMACY_MODULE_DIR=sa_pharmacy_management
#
#   Odoo 19:
# ODOO_VERSION=19.0
# PHARMACY_MODULE=sa_pharmacy_management
# PHARMACY_MODULE_DIR=sa_pharmacy_management_19
#
#   Odoo 17:
# ODOO_VERSION=17.0
# PHARMACY_MODULE=sa_pharmacy_management
# PHARMACY_MODULE_DIR=sa_pharmacy_management_17

# --- Web ----------------------------------------------------------------------
ODOO_PORT=8069

# --- Database -----------------------------------------------------------------
POSTGRES_DB=pharmacy
POSTGRES_USER=odoo
# REQUIRED: set a strong password. Stack refuses to start without it.
POSTGRES_PASSWORD=change-me-strong-password
