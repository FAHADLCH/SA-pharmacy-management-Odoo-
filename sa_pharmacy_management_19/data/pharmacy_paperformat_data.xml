<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 80mm thermal roll (typical receipt printer) -->
        <record id="paperformat_thermal_80" model="report.paperformat">
            <field name="name">Pharmacy Thermal 80mm</field>
            <field name="default" eval="False"/>
            <field name="format">custom</field>
            <field name="page_width">80</field>
            <field name="page_height">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">3</field>
            <field name="margin_bottom">3</field>
            <field name="margin_left">3</field>
            <field name="margin_right">3</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">3</field>
            <field name="dpi">203</field>
        </record>

        <!-- 58mm thermal roll (compact receipt printer) -->
        <record id="paperformat_thermal_58" model="report.paperformat">
            <field name="name">Pharmacy Thermal 58mm</field>
            <field name="default" eval="False"/>
            <field name="format">custom</field>
            <field name="page_width">58</field>
            <field name="page_height">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">2</field>
            <field name="margin_bottom">2</field>
            <field name="margin_left">2</field>
            <field name="margin_right">2</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">2</field>
            <field name="dpi">203</field>
        </record>

    </data>
</odoo>
