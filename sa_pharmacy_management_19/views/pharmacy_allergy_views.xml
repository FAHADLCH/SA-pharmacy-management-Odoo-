<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_allergy_tree" model="ir.ui.view">
        <field name="name">pharmacy.allergy.tree</field>
        <field name="model">pharmacy.allergy</field>
        <field name="arch" type="xml">
            <list string="Allergens" editable="bottom">
                <field name="name"/>
                <field name="ingredient_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_allergy" model="ir.actions.act_window">
        <field name="name">Allergens</field>
        <field name="res_model">pharmacy.allergy</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Maintain your allergen registry
            </p><p>
                Link allergens to active ingredients so PharmaCore can block
                unsafe dispensing automatically.
            </p>
        </field>
    </record>

</odoo>
