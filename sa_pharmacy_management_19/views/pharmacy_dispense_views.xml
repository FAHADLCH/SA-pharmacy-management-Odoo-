<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dispense_tree" model="ir.ui.view">
        <field name="name">pharmacy.dispense.tree</field>
        <field name="model">pharmacy.dispense</field>
        <field name="arch" type="xml">
            <list string="Dispensings"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="prescription_id" optional="show"/>
                <field name="pharmacist_id"/>
                <field name="dispense_date"/>
                <field name="has_controlled" widget="boolean_toggle"
                       string="Controlled" optional="show"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_dispense_form" model="ir.ui.view">
        <field name="name">pharmacy.dispense.form</field>
        <field name="model">pharmacy.dispense</field>
        <field name="arch" type="xml">
            <form string="Dispense">
                <header>
                    <button name="action_dispense" type="object"
                            string="Dispense &amp; Deliver" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_print_receipt" type="object"
                            string="Print Receipt" class="btn-secondary"
                            invisible="state != 'done'"/>
                    <button name="action_print_label" type="object"
                            string="Print Label"
                            invisible="state != 'done'"/>
                    <button name="%(action_pharmacy_ai_assistant)d"
                            type="action" string="AI Assistant"
                            class="btn-secondary" icon="fa-magic"
                            context="{'default_patient_id': patient_id, 'default_prescription_id': prescription_id}"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="not picking_id">
                            <span class="o_stat_text">Delivery</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Controlled"
                            bg_color="text-bg-danger"
                            invisible="not has_controlled"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="prescription_id"/>
                            <field name="pharmacist_id"/>
                        </group>
                        <group>
                            <field name="dispense_date"/>
                            <field name="warehouse_id"/>
                            <field name="counseling_done"/>
                            <field name="currency_id"
                                   groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="expiration_date"/>
                            <field name="product_qty"/>
                            <field name="uom_id" groups="uom.group_uom"/>
                            <field name="price_unit"/>
                            <field name="dosage"/>
                            <field name="subtotal"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="amount_total" widget="monetary"/>
                    </group>
                    <field name="note" placeholder="Internal notes..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_dispensings" model="ir.actions.act_window">
        <field name="name">Dispensing</field>
        <field name="res_model">pharmacy.dispense</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Dispense medicines with full batch traceability
            </p><p>
                PharmaCore suggests the earliest-expiring batch (FEFO), blocks
                unsafe items and posts the stock delivery in one click.
            </p>
        </field>
    </record>

</odoo>
