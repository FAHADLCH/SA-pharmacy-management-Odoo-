<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_active_ingredient_tree" model="ir.ui.view">
        <field name="name">pharmacy.active.ingredient.tree</field>
        <field name="model">pharmacy.active.ingredient</field>
        <field name="arch" type="xml">
            <tree string="Active Ingredients">
                <field name="code"/>
                <field name="name"/>
                <field name="atc_code"/>
                <field name="therapeutic_class"/>
                <field name="is_controlled" widget="boolean_toggle"/>
                <field name="product_count" string="Medicines"/>
            </tree>
        </field>
    </record>

    <record id="view_active_ingredient_form" model="ir.ui.view">
        <field name="name">pharmacy.active.ingredient.form</field>
        <field name="model">pharmacy.active.ingredient</field>
        <field name="arch" type="xml">
            <form string="Active Ingredient">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object"
                                class="oe_stat_button" icon="fa-medkit">
                            <field name="product_count" widget="statinfo"
                                   string="Medicines"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Controlled"
                            bg_color="text-bg-danger"
                            invisible="not is_controlled"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Paracetamol"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="atc_code"/>
                            <field name="therapeutic_class"/>
                        </group>
                        <group>
                            <field name="is_controlled"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_active_ingredient" model="ir.actions.act_window">
        <field name="name">Active Ingredients</field>
        <field name="res_model">pharmacy.active.ingredient</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Build your active-ingredient library
            </p><p>
                Active ingredients power generic substitution, drug-interaction
                screening and allergy alerts across the pharmacy.
            </p>
        </field>
    </record>

</odoo>
