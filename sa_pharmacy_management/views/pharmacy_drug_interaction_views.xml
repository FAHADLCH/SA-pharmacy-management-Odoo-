<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_drug_interaction_tree" model="ir.ui.view">
        <field name="name">pharmacy.drug.interaction.tree</field>
        <field name="model">pharmacy.drug.interaction</field>
        <field name="arch" type="xml">
            <tree string="Drug Interactions" decoration-danger="severity in ('major','contraindicated')" decoration-warning="severity == 'moderate'">
                <field name="ingredient_a_id"/>
                <field name="ingredient_b_id"/>
                <field name="severity" widget="badge"
                       decoration-danger="severity in ('major','contraindicated')"
                       decoration-warning="severity == 'moderate'"
                       decoration-info="severity == 'minor'"/>
                <field name="description" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_drug_interaction_form" model="ir.ui.view">
        <field name="name">pharmacy.drug.interaction.form</field>
        <field name="model">pharmacy.drug.interaction</field>
        <field name="arch" type="xml">
            <form string="Drug Interaction">
                <sheet>
                    <group>
                        <group>
                            <field name="ingredient_a_id"/>
                            <field name="ingredient_b_id"/>
                        </group>
                        <group>
                            <field name="severity" widget="badge"/>
                            <field name="reference"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Interaction Effect">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Clinical Management Advice">
                        <field name="clinical_advice" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_drug_interaction" model="ir.actions.act_window">
        <field name="name">Drug Interactions</field>
        <field name="res_model">pharmacy.drug.interaction</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define drug-drug interactions
            </p><p>
                Every interaction you record here is automatically screened on
                prescriptions and at the point of dispensing.
            </p>
        </field>
    </record>

</odoo>
