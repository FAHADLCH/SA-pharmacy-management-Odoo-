<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_pharmacy" model="ir.ui.view">
        <field name="name">product.template.form.pharmacy</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="is_medicine"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Pharmacy" name="pharmacy"
                      invisible="not is_medicine">
                    <group>
                        <group string="Classification">
                            <field name="medicine_kind"/>
                            <field name="active_ingredient_ids"
                                   widget="many2many_tags"
                                   options="{'color_field': 'is_controlled'}"/>
                            <field name="strength"/>
                            <field name="dosage_form"/>
                            <field name="therapeutic_class"/>
                            <field name="atc_code"/>
                            <field name="manufacturer_id"/>
                        </group>
                        <group string="Dispensing Rules">
                            <field name="prescription_required"/>
                            <field name="is_controlled"/>
                            <field name="control_schedule"
                                   invisible="not is_controlled"
                                   required="is_controlled"/>
                            <field name="storage_condition"/>
                            <field name="max_dispense_qty"/>
                            <field name="requires_counseling"/>
                        </group>
                    </group>
                    <button name="action_pharmacy_substitutes" type="object"
                            string="Find AI Alternatives" class="btn-secondary"
                            icon="fa-magic"
                            invisible="not active_ingredient_ids"/>
                    <div class="alert alert-info" role="alert"
                         invisible="not is_medicine">
                        Marking this product as a medicine enforces lot tracking
                        and expiration dates so batch traceability and FEFO work
                        end-to-end.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_product_medicine_tree" model="ir.ui.view">
        <field name="name">product.template.medicine.tree</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <tree string="Medicines">
                <field name="default_code" optional="show"/>
                <field name="name"/>
                <field name="strength" optional="show"/>
                <field name="dosage_form" optional="show"/>
                <field name="active_ingredient_ids" widget="many2many_tags"
                       optional="show"/>
                <field name="prescription_required" widget="boolean_toggle"/>
                <field name="is_controlled" widget="boolean_toggle"/>
                <field name="qty_available" string="On Hand"/>
                <field name="list_price"/>
            </tree>
        </field>
    </record>

    <record id="view_product_medicine_search" model="ir.ui.view">
        <field name="name">product.template.medicine.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search string="Medicines">
                <field name="name"/>
                <field name="active_ingredient_ids"/>
                <field name="therapeutic_class"/>
                <filter name="rx" string="Prescription Only"
                        domain="[('prescription_required','=',True)]"/>
                <filter name="controlled" string="Controlled"
                        domain="[('is_controlled','=',True)]"/>
                <separator/>
                <filter name="otc" string="OTC"
                        domain="[('medicine_kind','=','otc')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_form" string="Dosage Form"
                            context="{'group_by':'dosage_form'}"/>
                    <filter name="group_class" string="Therapeutic Class"
                            context="{'group_by':'therapeutic_class'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_medicines" model="ir.actions.act_window">
        <field name="name">Medicines</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="view_id" ref="view_product_medicine_tree"/>
        <field name="search_view_id" ref="view_product_medicine_search"/>
        <field name="domain">[('is_medicine','=',True)]</field>
        <field name="context">{'default_is_medicine': True, 'default_type': 'product', 'default_tracking': 'lot', 'default_use_expiration_date': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first medicine
            </p><p>
                Medicines automatically track batches and expiry dates, enabling
                FEFO dispensing and near-expiry alerts.
            </p>
        </field>
    </record>

</odoo>
