<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_lot_pharmacy_tree" model="ir.ui.view">
        <field name="name">stock.lot.pharmacy.tree</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <tree string="Batches"
                  decoration-danger="expiry_state in ('expired','critical')"
                  decoration-warning="expiry_state == 'warning'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="on_hand_qty"/>
                <field name="expiration_date"/>
                <field name="days_to_expiry"/>
                <field name="expiry_state" widget="badge"
                       decoration-danger="expiry_state in ('expired','critical')"
                       decoration-warning="expiry_state == 'warning'"
                       decoration-success="expiry_state == 'ok'"/>
            </tree>
        </field>
    </record>

    <record id="view_stock_lot_pharmacy_search" model="ir.ui.view">
        <field name="name">stock.lot.pharmacy.search</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <search string="Batches">
                <field name="name"/>
                <field name="product_id"/>
                <filter name="expired" string="Expired"
                        domain="[('expiry_state','=','expired')]"/>
                <filter name="critical" string="Critical (≤30d)"
                        domain="[('expiry_state','=','critical')]"/>
                <filter name="warning" string="Near Expiry (≤90d)"
                        domain="[('expiry_state','=','warning')]"/>
                <filter name="in_stock" string="In Stock"
                        domain="[('on_hand_qty','>',0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_expiry" string="Expiry Status"
                            context="{'group_by':'expiry_state'}"/>
                    <filter name="group_product" string="Medicine"
                            context="{'group_by':'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pharmacy_batches" model="ir.actions.act_window">
        <field name="name">Batches &amp; Expiry</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_stock_lot_pharmacy_tree"/>
        <field name="search_view_id" ref="view_stock_lot_pharmacy_search"/>
        <field name="domain">[('product_id.is_medicine','=',True)]</field>
    </record>

    <record id="action_pharmacy_near_expiry" model="ir.actions.act_window">
        <field name="name">Near-Expiry Batches</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_stock_lot_pharmacy_tree"/>
        <field name="search_view_id" ref="view_stock_lot_pharmacy_search"/>
        <field name="domain">[('product_id.is_medicine','=',True),('on_hand_qty','>',0),('expiry_state','in',('expired','critical','warning'))]</field>
        <field name="context">{'search_default_group_expiry': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No batches are approaching expiry
            </p><p>
                Great news — your shelf is healthy. Batches nearing their expiry
                date will surface here automatically.
            </p>
        </field>
    </record>

    <record id="action_expiry_report_wizard" model="ir.actions.act_window">
        <field name="name">Expiry Report</field>
        <field name="res_model">pharmacy.expiry.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_expiry_report_wizard_form" model="ir.ui.view">
        <field name="name">pharmacy.expiry.report.wizard.form</field>
        <field name="model">pharmacy.expiry.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Near-Expiry Report">
                <group>
                    <field name="horizon_days"/>
                    <field name="include_expired"/>
                </group>
                <footer>
                    <button name="action_open_report" type="object"
                            string="Run" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
