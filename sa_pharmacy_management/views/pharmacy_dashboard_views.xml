<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--  Dispensing analysis (header level)                          -->
    <!-- ============================================================ -->
    <record id="view_dispense_graph" model="ir.ui.view">
        <field name="name">pharmacy.dispense.graph</field>
        <field name="model">pharmacy.dispense</field>
        <field name="arch" type="xml">
            <graph string="Dispensing Trend" type="line" sample="1">
                <field name="dispense_date" interval="day"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_dispense_pivot" model="ir.ui.view">
        <field name="name">pharmacy.dispense.pivot</field>
        <field name="model">pharmacy.dispense</field>
        <field name="arch" type="xml">
            <pivot string="Dispensing Analysis" sample="1">
                <field name="pharmacist_id" type="row"/>
                <field name="dispense_date" interval="month" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_dispense_analysis" model="ir.actions.act_window">
        <field name="name">Dispensing Analysis</field>
        <field name="res_model">pharmacy.dispense</field>
        <field name="view_mode">graph,pivot</field>
        <field name="domain">[('state','=','done')]</field>
    </record>

    <!-- ============================================================ -->
    <!--  Medicine sales analysis (line level)                        -->
    <!-- ============================================================ -->
    <record id="view_dispense_line_graph" model="ir.ui.view">
        <field name="name">pharmacy.dispense.line.graph</field>
        <field name="model">pharmacy.dispense.line</field>
        <field name="arch" type="xml">
            <graph string="Top Medicines" type="bar" sample="1">
                <field name="product_id"/>
                <field name="subtotal" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_dispense_line_pivot" model="ir.ui.view">
        <field name="name">pharmacy.dispense.line.pivot</field>
        <field name="model">pharmacy.dispense.line</field>
        <field name="arch" type="xml">
            <pivot string="Medicine Sales Analysis" sample="1">
                <field name="product_id" type="row"/>
                <field name="dispense_date" interval="month" type="col"/>
                <field name="subtotal" type="measure"/>
                <field name="product_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_medicine_sales_analysis" model="ir.actions.act_window">
        <field name="name">Medicine Sales Analysis</field>
        <field name="res_model">pharmacy.dispense.line</field>
        <field name="view_mode">graph,pivot</field>
        <field name="domain">[('state','=','done')]</field>
        <field name="context">{'search_default_product_id': 1}</field>
    </record>

    <!-- ============================================================ -->
    <!--  Prescription analysis                                       -->
    <!-- ============================================================ -->
    <record id="view_prescription_graph" model="ir.ui.view">
        <field name="name">pharmacy.prescription.graph</field>
        <field name="model">pharmacy.prescription</field>
        <field name="arch" type="xml">
            <graph string="Prescriptions by Status" type="bar" sample="1">
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="view_prescription_risk_graph" model="ir.ui.view">
        <field name="name">pharmacy.prescription.risk.graph</field>
        <field name="model">pharmacy.prescription</field>
        <field name="arch" type="xml">
            <graph string="Clinical Risk Distribution" type="pie" sample="1">
                <field name="ai_risk_level"/>
            </graph>
        </field>
    </record>

    <record id="action_prescription_analysis" model="ir.actions.act_window">
        <field name="name">Prescription Analysis</field>
        <field name="res_model">pharmacy.prescription</field>
        <field name="view_mode">graph,pivot</field>
        <field name="view_id" ref="view_prescription_graph"/>
    </record>

    <record id="action_prescription_risk_analysis" model="ir.actions.act_window">
        <field name="name">Clinical Risk Distribution</field>
        <field name="res_model">pharmacy.prescription</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_prescription_risk_graph"/>
        <field name="domain">[('ai_risk_level','!=',False)]</field>
    </record>

    <!-- ============================================================ -->
    <!--  Pharmacy command-centre dashboard                           -->
    <!-- ============================================================ -->
    <record id="board_pharmacy_dashboard_form" model="ir.ui.view">
        <field name="name">pharmacy.dashboard.form</field>
        <field name="model">board.board</field>
        <field name="arch" type="xml">
            <form string="Pharmacy Dashboard">
                <board style="2-1">
                    <column>
                        <action name="%(action_dispense_analysis)d"
                                string="Revenue Trend"
                                view_mode="graph"/>
                        <action name="%(action_medicine_sales_analysis)d"
                                string="Top Medicines by Revenue"
                                view_mode="graph"/>
                        <action name="%(action_prescriptions)d"
                                string="Recent Prescriptions"/>
                    </column>
                    <column>
                        <action name="%(action_prescription_analysis)d"
                                string="Prescriptions by Status"
                                view_mode="graph"/>
                        <action name="%(action_prescription_risk_analysis)d"
                                string="Clinical Risk Distribution"
                                view_mode="graph"/>
                        <action name="%(action_pharmacy_near_expiry)d"
                                string="Near-Expiry Batches"/>
                    </column>
                </board>
            </form>
        </field>
    </record>

    <record id="board_pharmacy_dashboard" model="ir.actions.act_window">
        <field name="name">Pharmacy Dashboard</field>
        <field name="res_model">board.board</field>
        <field name="view_mode">form</field>
        <field name="usage">menu</field>
        <field name="view_id" ref="board_pharmacy_dashboard_form"/>
    </record>

</odoo>
