<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_pharmacy" model="ir.module.category">
            <field name="name">Pharmacy</field>
            <field name="description">Pharmacy management access levels</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_pharmacy_user" model="res.groups">
            <field name="name">Pharmacy / Pharmacist</field>
            <field name="category_id" ref="module_category_pharmacy"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <record id="group_pharmacy_manager" model="res.groups">
            <field name="name">Pharmacy / Manager</field>
            <field name="category_id" ref="module_category_pharmacy"/>
            <field name="implied_ids"
                   eval="[(4, ref('group_pharmacy_user')), (4, ref('stock.group_stock_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="rule_prescription_company" model="ir.rule">
            <field name="name">Prescription: multi-company</field>
            <field name="model_id" ref="model_pharmacy_prescription"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_dispense_company" model="ir.rule">
            <field name="name">Dispense: multi-company</field>
            <field name="model_id" ref="model_pharmacy_dispense"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
