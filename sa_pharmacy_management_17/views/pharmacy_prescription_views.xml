<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_prescription_tree" model="ir.ui.view">
        <field name="name">pharmacy.prescription.tree</field>
        <field name="model">pharmacy.prescription</field>
        <field name="arch" type="xml">
            <tree string="Prescriptions"
                  decoration-info="state == 'validated'"
                  decoration-success="state == 'dispensed'"
                  decoration-warning="state == 'partial'"
                  decoration-muted="state in ('cancelled','expired')">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="prescriber_id" optional="show"/>
                <field name="prescription_date"/>
                <field name="validity_date" optional="show"/>
                <field name="has_interaction" widget="boolean_toggle"
                       string="Interaction" optional="show"/>
                <field name="ai_risk_level" widget="badge" optional="show"
                       decoration-warning="ai_risk_level == 'moderate'"
                       decoration-danger="ai_risk_level in ('high','critical')"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'validated'"
                       decoration-success="state == 'dispensed'"
                       decoration-warning="state == 'partial'"/>
            </tree>
        </field>
    </record>

    <record id="view_prescription_kanban" model="ir.ui.view">
        <field name="name">pharmacy.prescription.kanban</field>
        <field name="model">pharmacy.prescription</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column"
                    sample="1">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="prescriber_id"/>
                <field name="prescription_date"/>
                <field name="validity_date"/>
                <field name="state"/>
                <field name="has_interaction"/>
                <field name="has_allergy_alert"/>
                <field name="ai_risk_level"/>
                <field name="dispense_count"/>
                <field name="activity_ids"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-1">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <field name="patient_id"/>
                                    </div>
                                </div>
                                <field name="ai_risk_level" widget="label_selection"
                                       options="{'classes': {'low': 'success', 'moderate': 'warning', 'high': 'danger', 'critical': 'danger'}}"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <span t-if="record.prescriber_id.value">
                                    <i class="fa fa-user-md me-1" title="Prescriber"/>
                                    <field name="prescriber_id"/>
                                </span>
                                <div class="mt-1">
                                    <i class="fa fa-calendar me-1" title="Prescribed"/>
                                    <field name="prescription_date"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <span t-if="record.has_interaction.raw_value"
                                          class="badge text-bg-warning me-1"
                                          title="Drug interaction">
                                        <i class="fa fa-exchange"/> Interaction
                                    </span>
                                    <span t-if="record.has_allergy_alert.raw_value"
                                          class="badge text-bg-danger"
                                          title="Allergy alert">
                                        <i class="fa fa-exclamation-triangle"/> Allergy
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_prescription_form" model="ir.ui.view">
        <field name="name">pharmacy.prescription.form</field>
        <field name="model">pharmacy.prescription</field>
        <field name="arch" type="xml">
            <form string="Prescription">
                <header>
                    <button name="action_validate" type="object"
                            string="Validate" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_open_dispense" type="object"
                            string="Dispense" class="btn-primary"
                            invisible="state not in ('validated','partial')"/>
                    <button name="action_ai_assess" type="object"
                            string="AI Risk Check" class="btn-secondary"
                            icon="fa-magic"/>
                    <button name="%(action_pharmacy_ai_assistant)d"
                            type="action" string="AI Assistant"
                            class="btn-secondary" icon="fa-comments"
                            context="{'default_prescription_id': id, 'default_patient_id': patient_id}"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            invisible="state not in ('validated','cancelled','expired')"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state in ('cancelled','dispensed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,validated,partial,dispensed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_dispensings" type="object"
                                class="oe_stat_button" icon="fa-truck">
                            <field name="dispense_count" widget="statinfo"
                                   string="Dispensings"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="not has_allergy_alert">
                        <strong>Allergy alert.</strong>
                        <field name="allergy_warning" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not has_interaction">
                        <strong>Drug interaction detected.</strong>
                        <field name="interaction_warning" nolabel="1"/>
                    </div>
                    <field name="ai_risk_summary" nolabel="1"
                           invisible="not ai_risk_summary" readonly="1"/>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="prescriber_id"/>
                            <field name="prescriber_name"
                                   invisible="prescriber_id"/>
                            <field name="prescriber_license"
                                   invisible="prescriber_id"/>
                        </group>
                        <group>
                            <field name="prescription_date"/>
                            <field name="validity_date"/>
                            <field name="refills_allowed"/>
                            <field name="refills_used"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Prescribed Items" name="items">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="uom_id" groups="uom.group_uom"/>
                                    <field name="dosage"/>
                                    <field name="duration_days"/>
                                    <field name="dispensed_qty"/>
                                    <field name="remaining_qty"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Clinical" name="clinical">
                            <group>
                                <field name="diagnosis"/>
                                <field name="note"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_prescription_search" model="ir.ui.view">
        <field name="name">pharmacy.prescription.search</field>
        <field name="model">pharmacy.prescription</field>
        <field name="arch" type="xml">
            <search string="Prescriptions">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="prescriber_id"/>
                <filter name="draft" string="Draft"
                        domain="[('state','=','draft')]"/>
                <filter name="validated" string="Validated"
                        domain="[('state','=','validated')]"/>
                <filter name="to_dispense" string="To Dispense"
                        domain="[('state','in',('validated','partial'))]"/>
                <filter name="with_interaction" string="Has Interaction"
                        domain="[('has_interaction','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status"
                            context="{'group_by':'state'}"/>
                    <filter name="group_patient" string="Patient"
                            context="{'group_by':'patient_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_prescriptions" model="ir.actions.act_window">
        <field name="name">Prescriptions</field>
        <field name="res_model">pharmacy.prescription</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_prescription_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Capture your first prescription
            </p><p>
                PharmaCore screens every prescription for drug interactions and
                patient allergies the moment you add items.
            </p>
        </field>
    </record>

</odoo>
