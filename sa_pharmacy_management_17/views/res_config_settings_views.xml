<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pharmacy_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.pharmacy</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Pharmacy" string="Pharmacy" name="sa_pharmacy_management"
                     logo="/sa_pharmacy_management/static/description/icon.png">
                    <block title="Expiry Management"
                           id="pharmacy_expiry_block">
                        <setting string="Near-Expiry Threshold"
                                 help="Batches within this many days are flagged as near expiry.">
                            <field name="pharmacy_warning_days"/>
                        </setting>
                        <setting string="Critical Threshold"
                                 help="Batches within this many days are flagged as critical.">
                            <field name="pharmacy_critical_days"/>
                        </setting>
                        <setting string="Block Expired Stock"
                                 help="Prevent dispensing of expired batches.">
                            <field name="pharmacy_block_expired"/>
                        </setting>
                    </block>
                    <block title="Dispensing Strategy"
                           id="pharmacy_strategy_block">
                        <setting string="Enforce FEFO"
                                 help="Apply First-Expiry-First-Out removal on medicine categories.">
                            <field name="pharmacy_enforce_fefo"/>
                        </setting>
                    </block>
                    <block title="Region &amp; Localisation"
                           id="pharmacy_region_block">
                        <setting string="Active Region"
                                 help="Pick a regional profile to localise scheduling, language and receipts.">
                            <field name="pharmacy_region_id"
                                   options="{'no_create': True}"/>
                        </setting>
                        <setting string="Receipt Format"
                                 help="Default paper used when printing customer receipts.">
                            <field name="pharmacy_receipt_paper"/>
                        </setting>
                        <setting string="Regulatory Footer"
                                 help="Legal text printed on every receipt / label.">
                            <field name="pharmacy_regulatory_footer"
                                   placeholder="Keep out of reach of children..."/>
                        </setting>
                    </block>
                    <block title="Artificial Intelligence"
                           id="pharmacy_ai_block">
                        <setting string="AI Decision Support"
                                 help="Enable AI risk scoring, substitution and the clinical assistant.">
                            <field name="pharmacy_ai_enabled"/>
                        </setting>
                        <setting string="AI Provider"
                                 help="Built-in works offline. Choose an OpenAI-compatible endpoint for tailored answers."
                                 invisible="not pharmacy_ai_enabled">
                            <field name="pharmacy_ai_provider"/>
                            <div class="content-group mt-2"
                                 invisible="pharmacy_ai_provider != 'openai'">
                                <div class="row mt-2">
                                    <label for="pharmacy_ai_endpoint"
                                           class="col-lg-4 o_light_label"/>
                                    <field name="pharmacy_ai_endpoint"
                                           class="col-lg-8"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="pharmacy_ai_model"
                                           class="col-lg-4 o_light_label"/>
                                    <field name="pharmacy_ai_model"
                                           class="col-lg-8"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="pharmacy_ai_api_key"
                                           class="col-lg-4 o_light_label"/>
                                    <field name="pharmacy_ai_api_key"
                                           password="True" class="col-lg-8"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_pharmacy_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'sa_pharmacy_management'}</field>
    </record>

</odoo>
