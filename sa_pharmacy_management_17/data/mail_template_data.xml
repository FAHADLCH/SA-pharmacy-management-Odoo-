<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_near_expiry" model="mail.template">
            <field name="name">Pharmacy: Near-Expiry Alert</field>
            <field name="model_id" ref="model_stock_lot"/>
            <field name="subject">Pharmacy alert: medicine batches approaching expiry</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="body_html" type="html">
                <div style="font-family:Arial,Helvetica,sans-serif;color:#1f2933;">
                    <p>Hello,</p>
                    <p>The automated PharmaCore expiry scan has detected medicine
                    batches that require your attention. Please review the
                    Near-Expiry dashboard and action returns or write-offs.</p>
                    <p style="color:#9aa5b1;font-size:12px;">
                        Generated by PharmaCore • SA Systems
                    </p>
                </div>
            </field>
        </record>

    </data>
</odoo>
