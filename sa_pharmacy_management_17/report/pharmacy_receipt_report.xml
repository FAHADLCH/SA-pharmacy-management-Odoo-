<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Thermal receipt template (80mm / 58mm roll)                  -->
    <!-- ============================================================ -->
    <template id="report_dispense_receipt_thermal_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page"
                     style="font-family:'DejaVu Sans Mono',monospace;font-size:11px;color:#000;width:100%;">
                    <div style="text-align:center;">
                        <div style="font-size:15px;font-weight:700;letter-spacing:1px;">
                            <span t-field="doc.company_id.name"/>
                        </div>
                        <div t-if="doc.company_id.phone" style="font-size:10px;">
                            Tel: <span t-field="doc.company_id.phone"/>
                        </div>
                        <div style="font-size:10px;">PHARMACY RECEIPT</div>
                    </div>
                    <div style="border-top:1px dashed #000;margin:4px 0;"/>
                    <div>
                        <div>Ref : <span t-field="doc.name"/></div>
                        <div>Date: <span t-field="doc.dispense_date" t-options="{'widget': 'datetime'}"/></div>
                        <div>Pt  : <span t-field="doc.patient_id.name"/></div>
                        <div t-if="doc.prescription_id">Rx  : <span t-field="doc.prescription_id.name"/></div>
                        <div>Phm : <span t-field="doc.pharmacist_id.name"/></div>
                    </div>
                    <div style="border-top:1px dashed #000;margin:4px 0;"/>
                    <t t-foreach="doc.line_ids" t-as="line">
                        <div style="font-weight:700;">
                            <span t-field="line.product_id.display_name"/>
                        </div>
                        <div style="display:flex;justify-content:space-between;">
                            <span>
                                <span t-field="line.product_qty"/> x
                                <span t-field="line.price_unit"
                                      t-options="{'widget': 'float', 'precision': 2}"/>
                            </span>
                            <span t-field="line.subtotal"
                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                        </div>
                        <div t-if="line.lot_id" style="font-size:10px;">
                            Batch <span t-field="line.lot_id.name"/>
                            <t t-if="line.expiration_date">
                                · Exp <span t-field="line.expiration_date" t-options="{'widget': 'date'}"/>
                            </t>
                        </div>
                        <div t-if="line.dosage" style="font-size:10px;">
                            SIG: <span t-field="line.dosage"/>
                        </div>
                    </t>
                    <div style="border-top:1px dashed #000;margin:4px 0;"/>
                    <div style="display:flex;justify-content:space-between;font-weight:700;font-size:13px;">
                        <span>TOTAL</span>
                        <span t-field="doc.amount_total"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </div>
                    <div t-if="doc.has_controlled"
                         style="text-align:center;margin-top:4px;font-weight:700;">
                        *** CONTROLLED SUBSTANCE ***
                    </div>
                    <div style="border-top:1px dashed #000;margin:4px 0;"/>
                    <div style="font-size:9px;text-align:center;">
                        <t t-set="footer" t-value="doc._pharmacy_region_footer()"/>
                        <span t-if="footer" t-esc="footer"/>
                        <div style="margin-top:4px;">Get well soon — <span t-field="doc.company_id.name"/></div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_dispense_receipt_thermal" model="ir.actions.report">
        <field name="name">Receipt (Thermal)</field>
        <field name="model">pharmacy.dispense</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sa_pharmacy_management.report_dispense_receipt_thermal_document</field>
        <field name="report_file">sa_pharmacy_management.report_dispense_receipt_thermal_document</field>
        <field name="paperformat_id" ref="paperformat_thermal_80"/>
        <field name="binding_model_id" ref="model_pharmacy_dispense"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ============================================================ -->
    <!-- A4 receipt template                                          -->
    <!-- ============================================================ -->
    <template id="report_dispense_receipt_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 style="color:#E8242A;">Dispensing Receipt</h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Receipt:</strong> <span t-field="doc.name"/><br/>
                                <strong>Patient:</strong> <span t-field="doc.patient_id.name"/><br/>
                                <strong>Pharmacist:</strong> <span t-field="doc.pharmacist_id.name"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Date:</strong> <span t-field="doc.dispense_date"/><br/>
                                <t t-if="doc.prescription_id">
                                    <strong>Rx:</strong> <span t-field="doc.prescription_id.name"/>
                                </t>
                            </div>
                        </div>
                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th>Medicine</th>
                                    <th>Batch</th>
                                    <th>Expiry</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Unit</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td><span t-field="line.product_id.display_name"/></td>
                                    <td><span t-field="line.lot_id.name"/></td>
                                    <td><span t-field="line.expiration_date" t-options="{'widget': 'date'}"/></td>
                                    <td class="text-end"><span t-field="line.product_qty"/></td>
                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                    <td class="text-end">
                                        <span t-field="line.subtotal"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row">
                            <div class="col-8"/>
                            <div class="col-4 text-end">
                                <strong>Total: </strong>
                                <span t-field="doc.amount_total"
                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                            </div>
                        </div>
                        <p t-if="doc.has_controlled" class="text-danger fw-bold mt-3">
                            Controlled substance — register entry recorded.
                        </p>
                        <p style="font-size:11px;color:#627d98;margin-top:18px;">
                            <t t-set="footer" t-value="doc._pharmacy_region_footer()"/>
                            <span t-if="footer" t-esc="footer"/>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_dispense_receipt" model="ir.actions.report">
        <field name="name">Receipt (A4)</field>
        <field name="model">pharmacy.dispense</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sa_pharmacy_management.report_dispense_receipt_document</field>
        <field name="report_file">sa_pharmacy_management.report_dispense_receipt_document</field>
        <field name="binding_model_id" ref="model_pharmacy_dispense"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
